+    // GALAXY: Returns a brightened version of the color for bold text.
+    // Blends toward white, matching Terminal.app's behavior of showing bold
+    // text at higher intensity when using the default foreground color.
+    func brightened() -> NSColor {
+        guard let color = self.usingColorSpace(.deviceRGB) else {
+            return self
+        }
+
+        var red: CGFloat = 0.0, green: CGFloat = 0.0, blue: CGFloat = 0.0, alpha: CGFloat = 1.0
+        color.getRed(&red, green: &green, blue: &blue, alpha: &alpha)
+        // GALAXY: Blend toward white — tune this for bold text brightness (0.0-1.0)
+        let brightFactor: CGFloat = 0.6
+        return NSColor(calibratedRed: red + (1.0 - red) * brightFactor,
+                       green: green + (1.0 - green) * brightFactor,
+                       blue: blue + (1.0 - blue) * brightFactor,
+                       alpha: alpha)
+    }
+
