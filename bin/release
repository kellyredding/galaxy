#!/usr/bin/env bash
# Releases the version in VERSION: checks, packages a signed archive, verifies
# it, then tags vX.Y.Z and publishes a GitHub release with the archive and the
# notes in release-notes/vX.Y.Z.md, which must already be committed.
#
# Usage: bin/release [--dry-run] [--fresh]
#
#   --dry-run   Do everything up to the tag, and stop. Nothing is pushed or
#               published; the verified archive is left in dist/.
#   --fresh     Rerun the checks and rebuild, even when dist/ already holds an
#               archive checked and verified for this commit.
#
# A release right after a dry run of the same commit reuses that run's archive
# instead of rerunning every check and rebuilding; it is verified again first.
#
# Run it from a real terminal: signing reads the release identity from
# 1Password, whose approval does not reach a shell without one.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
REPO="kellyredding/galaxy"
ASSET="galaxy-darwin-arm64.tar.gz"
IDENTITY="Galaxy Release Signing"

dry_run=false
fresh=false
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=true ;;
    --fresh) fresh=true ;;
    -h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "bin/release: unknown option '$arg'" >&2; exit 2 ;;
  esac
done

say() { printf '==> %s\n' "$*"; }
die() { printf 'bin/release: %s\n' "$*" >&2; exit 1; }

cd "$ROOT"
version="$(tr -d '[:space:]' < VERSION)"
tag="v$version"
release_notes="release-notes/$tag.md"

# --- Everything that can refuse a release, before the slow parts -----------

branch="$(git rev-parse --abbrev-ref HEAD)"
[[ "$branch" == "main" ]] || die "releases are made from main (currently on $branch). Merge, then release."
[[ -z "$(git status --porcelain)" ]] || die "the working tree has changes."
git fetch -q origin main --tags
[[ "$(git rev-parse HEAD)" == "$(git rev-parse origin/main)" ]] \
  || die "main is not origin/main. Pull, or push what is unpushed, and release again."
! git rev-parse -q --verify "refs/tags/$tag" >/dev/null || die "$tag already exists. Bump VERSION first."
[[ -s "$release_notes" ]] \
  || die "$release_notes is missing. Write the notes with the version bump, and release once they are merged."
gh auth status >/dev/null 2>&1 || die "gh is not signed in. Run: gh auth login"
command -v op >/dev/null || die "the 1Password CLI (op) is not installed."

say "Releasing Galaxy $version"

# --- Check and package, unless a dry run already did for this commit -------

# Written only after a run's checks pass and its archive verifies, holding the
# commit it was for. A new commit, a changed archive or --fresh means a full run.
checked_stamp="$ROOT/dist/.checked-commit"
head="$(git rev-parse HEAD)"
reuse=false
if ! $fresh && [[ -f "$checked_stamp" && -f "$ROOT/dist/$ASSET" && -f "$ROOT/dist/$ASSET.sha256" ]] \
   && [[ "$(cat "$checked_stamp")" == "$head" ]]; then
  reuse=true
fi

if $reuse; then
  say "Reusing the archive a dry run checked and built for ${head:0:12} (--fresh to redo)"
else
  say "Running every check (make check, app-check)"
  # Passing checks print a great deal to stderr (expected spec errors, Xcode's
  # simulator warnings), so their output is kept in a log shown only on failure.
  check_log="$(mktemp -t galaxy-release-checks)"
  if ! { make check && make app-check; } > "$check_log" 2>&1; then
    tail -40 "$check_log" >&2
    die "a check failed; full log: $check_log"
  fi
  rm -f "$check_log"
  # A check that writes into the tree would make packaging refuse it, so name
  # the file here rather than leave that refusal to explain itself.
  [[ -z "$(git status --porcelain)" ]] \
    || die "the checks modified the working tree:"$'\n'"$(git status --short)"

  say "Packaging"
  rm -rf "$ROOT/dist"
  "$ROOT/bin/package" --sign op --out "$ROOT/dist"
fi

# --- Verify, always: a reused archive is checked as hard as a new one -------

say "Verifying the archive"
verify="$(mktemp -d)"
trap 'rm -rf "${verify:?}"' EXIT
(cd "$ROOT/dist" && shasum -a 256 -c "$ASSET.sha256" >/dev/null) || die "checksum does not match"
tar -xzf "$ROOT/dist/$ASSET" -C "$verify"
pkg="$verify/galaxy"
grep -q "\"version\": \"$version\"" "$pkg/manifest.json" || die "manifest is not version $version"
grep -q '"dirty": false' "$pkg/manifest.json" || die "the archive was built from a dirty tree"
grep -q "\"commit\": \"${head:0:12}\"" "$pkg/manifest.json" \
  || die "the archive was not built from ${head:0:12}; run with --fresh"
for bin in "$pkg"/bin/*; do
  name="$(basename "$bin")"
  want="$(sed -n "s/^    \"$name\": \"\(.*\)\",\{0,1\}$/\1/p" "$pkg/manifest.json")"
  have="$("$bin" --version | awk '{print $NF}')"
  [[ -n "$want" && "$have" == "$want" ]] || die "$name reports $have, manifest says $want"
done
codesign --verify --strict "$pkg/Galaxy.app" || die "Galaxy.app does not verify"
# Captured before matching: under pipefail, `| grep -q` exits on its match,
# codesign dies of SIGPIPE writing the lines after it, and the check fails.
signature="$(codesign -dv --verbose=2 "$pkg/Galaxy.app" 2>&1)"
[[ "$signature" == *$'\n'"Authority=$IDENTITY"$'\n'* ]] \
  || die "Galaxy.app is not signed by $IDENTITY"
echo "    archive verified: $(find "$pkg/bin" -type f | wc -l | tr -d ' ') tools, app signed by $IDENTITY"
printf '%s\n' "$head" > "$checked_stamp"

# --- Release description ---------------------------------------------------

# The summary is written by hand (with an agent's draft) in the version-bump
# PR, so it is reviewed before it is published; this only adds install steps.
notes="$verify/notes.md"
{
  echo "Install or update:"
  echo
  echo '```bash'
  echo "curl -fsSL https://raw.githubusercontent.com/$REPO/main/install.sh | bash"
  echo '```'
  echo
  echo "Apple Silicon, macOS 26 or later. Download with the script, not a browser:"
  echo "the app is self-signed, and macOS blocks a browser download of it."
  echo
  echo "## What's new"
  echo
  cat "$release_notes"
} > "$notes"

if $dry_run; then
  say "Dry run: stopping before the tag. Archive: $ROOT/dist/$ASSET"
  say "The release description would be:"
  echo
  cat "$notes"
  exit 0
fi

# --- Tag and publish -------------------------------------------------------

say "Tagging $tag"
git tag -a "$tag" -m "Galaxy $version"
git push -q origin "$tag"

say "Publishing the GitHub release"
gh release create "$tag" --repo "$REPO" --title "Galaxy $version" --notes-file "$notes" \
  "$ROOT/dist/$ASSET" "$ROOT/dist/$ASSET.sha256"

say "Released $tag: https://github.com/$REPO/releases/tag/$tag"
