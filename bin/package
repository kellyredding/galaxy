#!/usr/bin/env bash
# Builds every CLI tool and a Release Galaxy.app from this tree, signs the
# app, and writes one archive for install.sh:
#
#   <out>/galaxy-darwin-arm64.tar.gz
#   <out>/galaxy-darwin-arm64.tar.gz.sha256
#
# Usage: bin/package [--local] [--sign op|adhoc] [--out DIR]
#
#   --local   Allow uncommitted changes (for `galaxy update --local`). Signs
#             with the release identity when op is installed, ad-hoc
#             otherwise. Pass --sign adhoc to skip 1Password on purpose.
#   --sign    Force a signing mode. A release (no --local) always uses op.
#   --out     Where to write the archive (default: dist/).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TOOLS=(galaxy statusline ledger artifacts timeline agents diff files)
ASSET="galaxy-darwin-arm64.tar.gz"
MIN_MACOS=26

local_build=false
sign=""
out="$ROOT/dist"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --local) local_build=true ;;
    --sign) sign="${2:?--sign needs op or adhoc}"; shift ;;
    --out) out="${2:?--out needs a directory}"; shift ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "bin/package: unknown option '$1'" >&2; exit 2 ;;
  esac
  shift
done

say() { printf '==> %s\n' "$*"; }
die() { printf 'bin/package: %s\n' "$*" >&2; exit 1; }

# Build tools are loud on stderr even when they succeed. Keep each step's
# output in a log and show its tail only when the step fails.
logdir="$(mktemp -d)"
run_logged() {
  local name="$1"; shift
  local log="$logdir/$name.log"
  if ! "$@" > "$log" 2>&1; then
    tail -40 "$log" >&2
    die "$name failed; full log: $log"
  fi
}

# --- Preflight -------------------------------------------------------------

[[ "$(uname -m)" == "arm64" ]] || die "Galaxy releases are built on Apple Silicon (arm64) only."
macos="$(sw_vers -productVersion)"
(( ${macos%%.*} >= MIN_MACOS )) || die "macOS $MIN_MACOS or later is required (this Mac runs $macos)."

for cmd in git xcodebuild xcodegen crystal shards node tar shasum; do
  command -v "$cmd" >/dev/null || die "'$cmd' is not installed. See SETUP.md."
done
xcodebuild -showComponent MetalToolchain 2>/dev/null | grep -q 'Status: installed' \
  || die "Xcode's Metal toolchain is missing (SwiftTerm has a shader). Run: xcodebuild -downloadComponent MetalToolchain"

cd "$ROOT"
dirty=false
[[ -n "$(git status --porcelain)" ]] && dirty=true
if ! $local_build && $dirty; then
  die "the working tree has changes. Commit them, or use --local."
fi

# Local builds sign with the release identity whenever op is installed, and
# fail rather than fall back: an ad-hoc build makes macOS ask for Galaxy's
# permissions again, which is easy to miss in the output. `op whoami` cannot
# decide this, since it reports "not signed in" without ever prompting.
if [[ -z "$sign" ]]; then
  if ! $local_build || command -v op >/dev/null; then
    sign=op
  else
    sign=adhoc
  fi
fi
if ! $local_build && [[ "$sign" != "op" ]]; then
  die "a release must be signed with the release identity (--sign op)."
fi

version="$(tr -d '[:space:]' < VERSION)"
commit="$(git rev-parse --short=12 HEAD)"
built_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

say "Packaging Galaxy $version ($commit$($dirty && echo ', uncommitted changes')), signing: $sign"

# --- Build -----------------------------------------------------------------

for t in "${TOOLS[@]}"; do
  say "Building $t"
  run_logged "build-$t" make -C "tools/$t" build
done

say "Building Galaxy.app (Release)"
run_logged "build-app" make -C GalaxyApp release
app_product="GalaxyApp/build/Build/Products/Release/Galaxy.app"
[[ -d "$app_product" ]] || die "the app build produced nothing at $app_product"
# Xcode registers what it builds with Launch Services. A second registered
# Galaxy.app can receive galaxy:// links meant for the one that is running.
/System/Library/Frameworks/CoreServices.framework/Versions/Current/Frameworks/LaunchServices.framework/Versions/Current/Support/lsregister \
  -u "$ROOT/$app_product" 2>/dev/null || true

# --- Stage -----------------------------------------------------------------

work="$(mktemp -d)"
packaged=false
gx_cleanup() {
  rm -rf "${work:?}"
  # Logs survive a failure, so the path in the error message still exists.
  $packaged && rm -rf "${logdir:?}"
  return 0
}
trap gx_cleanup EXIT
stage="$work/galaxy"
mkdir -p "$stage/bin"

tool_versions=()
for t in "${TOOLS[@]}"; do
  bin_name="galaxy-$t"; [[ "$t" == "galaxy" ]] && bin_name="galaxy"
  cp "tools/$t/build/$bin_name" "$stage/bin/$bin_name"
  tool_versions+=("$bin_name=$(tr -d '[:space:]' < "tools/$t/version.txt")")
done

ditto "$app_product" "$stage/Galaxy.app"
plist="$stage/Galaxy.app/Contents/Info.plist"
pb() { /usr/libexec/PlistBuddy -c "$1" "$plist" >/dev/null; }
pb "Set :CFBundleShortVersionString $version"
pb "Add :GalaxySuiteVersion string $version"
pb "Add :GalaxyBuildCommit string $commit"
pb "Add :GalaxyBuildDirty bool $dirty"
pb "Add :GalaxyBuiltAt string $built_at"
pb "Add :GalaxyToolVersions dict"
for tv in "${tool_versions[@]}"; do
  pb "Add :GalaxyToolVersions:${tv%%=*} string ${tv#*=}"
done

say "Signing Galaxy.app ($sign)"
# Not logged: signing may need to tell the user to approve 1Password.
"$ROOT/bin/lib/sign-app.sh" "$sign" "$stage/Galaxy.app" 2>&1 | grep -v "replacing existing signature" || true
codesign -dv --verbose=2 "$stage/Galaxy.app" 2>&1 | grep -q "^Authority=" || [[ "$sign" == "adhoc" ]] \
  || die "signing with the release identity failed"
codesign --verify --strict "$stage/Galaxy.app" || die "the signed app does not verify"

printf '%s\n' "$version" > "$stage/VERSION"
{
  printf '{\n'
  printf '  "version": "%s",\n' "$version"
  printf '  "commit": "%s",\n' "$commit"
  printf '  "dirty": %s,\n' "$dirty"
  printf '  "built_at": "%s",\n' "$built_at"
  printf '  "signing": "%s",\n' "$sign"
  printf '  "tools": {\n'
  last=$(( ${#tool_versions[@]} - 1 ))
  for i in "${!tool_versions[@]}"; do
    tv="${tool_versions[$i]}"; sep=","; [[ $i -eq $last ]] && sep=""
    printf '    "%s": "%s"%s\n' "${tv%%=*}" "${tv#*=}" "$sep"
  done
  printf '  }\n}\n'
} > "$stage/manifest.json"

# --- Archive ---------------------------------------------------------------

mkdir -p "$out"
tar -czf "$out/$ASSET" -C "$work" galaxy
(cd "$out" && shasum -a 256 "$ASSET" > "$ASSET.sha256")

packaged=true
say "Wrote $out/$ASSET ($(du -h "$out/$ASSET" | cut -f1 | tr -d ' '))"
echo "$out/$ASSET"
