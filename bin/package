#!/usr/bin/env bash
# Builds every CLI tool and a Release Galaxy.app from this tree, for Apple
# Silicon and Intel, signs the app, and writes one archive for install.sh:
#
#   <out>/galaxy-darwin.tar.gz
#   <out>/galaxy-darwin.tar.gz.sha256
#
# Usage: bin/package [--local] [--sign op|adhoc] [--out DIR]
#
#   --local   Allow uncommitted changes (for `galaxy update --local`).
#   --sign    op (the default, always): the release identity from 1Password.
#             adhoc, with --local only, checks that a build signs. Never
#             install its archive: an ad-hoc Galaxy.app loses its Full Disk
#             Access and every other privacy permission.
#   --out     Where to write the archive (default: dist/).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TOOLS=(galaxy statusline ledger artifacts timeline agents diff files)
ASSET="galaxy-darwin.tar.gz"
# The Mac that builds a release, not the ones it runs on (bin/lib/universal.sh).
BUILD_MACOS=26
# shellcheck source-path=SCRIPTDIR source=lib/universal.sh
. "$ROOT/bin/lib/universal.sh"

local_build=false
sign=op
out="$ROOT/dist"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --local) local_build=true ;;
    --sign) sign="${2:?--sign needs op or adhoc}"; shift ;;
    --out) out="${2:?--out needs a directory}"; shift ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "bin/package: unknown option '$1'" >&2; exit 2 ;;
  esac
  shift
done

say() { printf '==> %s\n' "$*"; }
die() { printf 'bin/package: %s\n' "$*" >&2; exit 1; }

# No fallback to ad hoc when op is missing: an ad-hoc install silently costs
# Galaxy its Full Disk Access grant, which is easy to miss in the output.
[[ "$sign" == "op" || "$sign" == "adhoc" ]] || die "--sign takes op or adhoc, not '$sign'."
if [[ "$sign" == "adhoc" ]] && ! $local_build; then
  die "a release must be signed with the release identity (--sign op)."
fi

# --- Preflight -------------------------------------------------------------

[[ "$(uname -m)" == "arm64" ]] || die "Galaxy releases are built on Apple Silicon (arm64) only."
macos="$(sw_vers -productVersion)"
(( ${macos%%.*} >= BUILD_MACOS )) || die "building needs macOS $BUILD_MACOS or later (this Mac runs $macos)."

for cmd in git xcodebuild xcodegen crystal shards node tar shasum lipo vtool otool; do
  command -v "$cmd" >/dev/null || die "'$cmd' is not installed. See SETUP.md."
done
if [[ "$sign" == "op" ]]; then
  command -v op >/dev/null || die "the 1Password CLI (op) is not installed; it holds the signing identity."
fi
# Output is captured before matching throughout: under pipefail, `| grep -q`
# exits on its match, the writer dies of SIGPIPE, and the pipeline fails.
metal="$(xcodebuild -showComponent MetalToolchain 2>/dev/null || true)"
[[ "$metal" == *"Status: installed"* ]] \
  || die "Xcode's Metal toolchain is missing (SwiftTerm has a shader). Run: xcodebuild -downloadComponent MetalToolchain"

cd "$ROOT"
dirty=false
[[ -n "$(git status --porcelain)" ]] && dirty=true
if ! $local_build && $dirty; then
  die "the working tree has changes. Commit them, or use --local."
fi

version="$(tr -d '[:space:]' < VERSION)"
commit="$(git rev-parse --short=12 HEAD)"
built_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

say "Packaging Galaxy $version ($commit$($dirty && echo ', uncommitted changes')), signing: $sign"

# Build tools are loud on stderr even when they succeed. Keep each step's
# output in a log and show its tail only when the step fails. Logs survive a
# failure, so the path in the error message still exists.
logdir="$(mktemp -d)"
work=""
packaged=false
# shellcheck disable=SC2329 # run by the trap below
gx_cleanup() {
  [[ -n "$work" ]] && rm -rf "${work:?}"
  $packaged && rm -rf "${logdir:?}"
  return 0
}
trap gx_cleanup EXIT

run_logged() {
  local name="$1"; shift
  local log="$logdir/$name.log"
  if ! "$@" > "$log" 2>&1; then
    tail -40 "$log" >&2
    die "$name failed; full log: $log"
  fi
}

# --- Build -----------------------------------------------------------------

for t in "${TOOLS[@]}"; do
  say "Building $t"
  run_logged "build-$t" make -C "tools/$t" build
done

say "Building Galaxy.app (Release)"
run_logged "build-app" make -C GalaxyApp release
app_product="GalaxyApp/build/Build/Products/Release/Galaxy.app"
[[ -d "$app_product" ]] || die "the app build produced nothing at $app_product"

# --- Stage -----------------------------------------------------------------

work="$(mktemp -d)"
stage="$work/galaxy"
mkdir -p "$stage/bin"

tool_versions=()
for t in "${TOOLS[@]}"; do
  bin_name="galaxy-$t"; [[ "$t" == "galaxy" ]] && bin_name="galaxy"
  cp "tools/$t/build/$bin_name" "$stage/bin/$bin_name"
  tool_versions+=("$bin_name=$(tr -d '[:space:]' < "tools/$t/version.txt")")
done

ditto "$app_product" "$stage/Galaxy.app"
plist="$stage/Galaxy.app/Contents/Info.plist"
pb() { /usr/libexec/PlistBuddy -c "$1" "$plist" >/dev/null; }
pb "Set :CFBundleShortVersionString $version"
pb "Add :GalaxySuiteVersion string $version"
pb "Add :GalaxyBuildCommit string $commit"
pb "Add :GalaxyBuildDirty bool $dirty"
pb "Add :GalaxyBuiltAt string $built_at"
pb "Add :GalaxyToolVersions dict"
for tv in "${tool_versions[@]}"; do
  pb "Add :GalaxyToolVersions:${tv%%=*} string ${tv#*=}"
done

say "Checking every binary runs on $GALAXY_ARCHS, macOS $GALAXY_MIN_MACOS or later"
problem="$(gx_check_universal "$stage")" || die "$problem"

say "Signing Galaxy.app ($sign)"
# Not logged and not piped: op talks to the 1Password app on the user's
# behalf, and signing may need to ask the user to approve it.
"$ROOT/bin/lib/sign-app.sh" "$sign" "$stage/Galaxy.app" || die "signing failed"
signature="$(codesign -dv --verbose=2 "$stage/Galaxy.app" 2>&1)"
[[ "$signature" == *$'\nAuthority='* || "$sign" == "adhoc" ]] \
  || die "signing with the release identity failed"
codesign --verify --strict "$stage/Galaxy.app" || die "the signed app does not verify"

printf '%s\n' "$version" > "$stage/VERSION"
{
  printf '{\n'
  printf '  "version": "%s",\n' "$version"
  printf '  "commit": "%s",\n' "$commit"
  printf '  "dirty": %s,\n' "$dirty"
  printf '  "built_at": "%s",\n' "$built_at"
  printf '  "signing": "%s",\n' "$sign"
  printf '  "archs": "%s",\n' "$GALAXY_ARCHS"
  printf '  "min_macos": "%s",\n' "$GALAXY_MIN_MACOS"
  printf '  "tools": {\n'
  last=$(( ${#tool_versions[@]} - 1 ))
  for i in "${!tool_versions[@]}"; do
    tv="${tool_versions[$i]}"; sep=","; [[ $i -eq $last ]] && sep=""
    printf '    "%s": "%s"%s\n' "${tv%%=*}" "${tv#*=}" "$sep"
  done
  printf '  }\n}\n'
} > "$stage/manifest.json"

# --- Archive ---------------------------------------------------------------

mkdir -p "$out"
tar -czf "$out/$ASSET" -C "$work" galaxy
(cd "$out" && shasum -a 256 "$ASSET" > "$ASSET.sha256")

packaged=true
say "Wrote $out/$ASSET ($(du -h "$out/$ASSET" | cut -f1 | tr -d ' '))"
echo "$out/$ASSET"
